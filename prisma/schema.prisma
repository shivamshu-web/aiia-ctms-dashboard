datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StudyPhase {
  PHASE_I
  PHASE_II
  PHASE_III
  PHASE_IV
}

enum StudyStatus {
  PLANNING
  ONGOING
  ON_HOLD
  COMPLETED
}

enum SafetySeverity {
  MILD
  MODERATE
  SERIOUS
  PENDING
}

enum SafetyType {
  ADR
  SAE
}

model Study {
  id             String         @id @default(cuid())
  studyCode      String         @unique
  title          String
  phase          StudyPhase     @default(PHASE_III)
  sitesCount     Int            @default(1)
  targetPatients Int            @default(100)
  enrolledCount  Int            @default(0)
  status         StudyStatus    @default(PLANNING)
  ctriNumber     String?
  patients       Patient[]
  safetyReports  SafetyReport[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Patient {
  id           String    @id @default(cuid())
  subjectId    String    @unique
  studyId      String
  study        Study     @relation(fields: [studyId], references: [id], onDelete: Cascade)
  siteName     String
  gender       String
  age          Int
  enrollmentDate DateTime @default(now())
  status       String    @default("ACTIVE") // ACTIVE, COMPLETED, WITHDRAWN
  createdAt    DateTime  @default(now())
}

model SafetyReport {
  id           String         @id @default(cuid())
  reportNumber String         @unique
  studyId      String
  study        Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  type         SafetyType     @default(ADR)
  severity     SafetySeverity @default(MILD)
  description  String
  reportedBy   String
  status       String         @default("SUBMITTED")
  createdAt    DateTime       @default(now())
}